# Basic LLM config. Most users only need the endpoint, model, and API key.

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Advanced optional LLM config. Leave these empty unless you need manual control.
# LLM_REASONING_MODE defaults to auto.
# LLM_CAPABILITY_PRESET left empty means model capabilities are auto-detected.
# LLM_CAPABILITIES_JSON is only for advanced manual capability overrides.
# LLM_EXTRA_BODY is only for special provider request parameters.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_REASONING_MODE=auto
LLM_EXTRA_BODY=
LLM_CAPABILITY_PRESET=
# Example: {"max_context_tokens":131072,"max_input_tokens":131072,"max_output_tokens":8192}
LLM_CAPABILITIES_JSON=

# Optional DeepSeek compatibility aliases. Prefer the LLM_* names above.
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
AGENT_TEMPERATURE=

# Optional per-call LLM profiles. Leave empty to use stage defaults.
LLM_PROFILE_INITIAL_AGENT_TURN_MAX_TOKENS=
LLM_PROFILE_INITIAL_AGENT_TURN_TIMEOUT=
LLM_PROFILE_INITIAL_AGENT_TURN_TEMPERATURE=
LLM_PROFILE_INITIAL_AGENT_TURN_DISABLE_REASONING=
LLM_PROFILE_TOOL_CALL_MAX_TOKENS=
LLM_PROFILE_TOOL_CALL_TIMEOUT=
LLM_PROFILE_TOOL_CALL_TEMPERATURE=
LLM_PROFILE_TOOL_CALL_DISABLE_REASONING=
LLM_PROFILE_AGENT_CONTINUATION_MAX_TOKENS=
LLM_PROFILE_AGENT_CONTINUATION_TIMEOUT=
LLM_PROFILE_AGENT_CONTINUATION_TEMPERATURE=
LLM_PROFILE_AGENT_CONTINUATION_DISABLE_REASONING=
LLM_PROFILE_FINAL_ANSWER_MAX_TOKENS=
LLM_PROFILE_FINAL_ANSWER_TIMEOUT=
LLM_PROFILE_FINAL_ANSWER_TEMPERATURE=
LLM_PROFILE_FINAL_ANSWER_DISABLE_REASONING=
LLM_PROFILE_SINGLE_FILE_READ_FINAL_ANSWER_MAX_TOKENS=
LLM_PROFILE_SINGLE_FILE_READ_FINAL_ANSWER_TIMEOUT=
LLM_PROFILE_SINGLE_FILE_READ_FINAL_ANSWER_TEMPERATURE=
LLM_PROFILE_SINGLE_FILE_READ_FINAL_ANSWER_DISABLE_REASONING=

# Web Search Provider
# auto | searxng | tavily | disabled
WEB_SEARCH_PROVIDER=auto

# Optional: self-hosted or managed SearXNG URL.
# Leave empty unless using SearXNG.
# Example: https://search.example.com
SEARXNG_BASE_URL=

# Optional: Tavily API key.
TAVILY_API_KEY=

# Optional semantic retrieval. Do not commit real embedding API keys.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=
VECTOR_SEARCH_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.2

# User / Project Isolation v1
DEFAULT_USER_ID=default_user
DEFAULT_PROJECT_ID=default_project
WORKSPACE_ROOT=workspace_store
ENABLE_WORKSPACE_ISOLATION=true

# Service API v1
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ALLOW_ALL=false
API_DEBUG=false

# Lightweight API protection v1
API_AUTH_ENABLED=false
API_KEYS=dev-local-key
API_KEY_HEADER=X-API-Key
API_STATUS_PUBLIC=false

# Local daily quotas v1
RATE_LIMIT_ENABLED=true
DAILY_CHAT_LIMIT=100
DAILY_RAG_LIMIT=200
DAILY_WEB_SEARCH_LIMIT=50
DAILY_EMBEDDING_LIMIT=500
DAILY_DOCUMENT_LOAD_LIMIT=50
DAILY_SANDBOX_LIMIT=100

# Local cache v1
CACHE_ENABLED=true
CACHE_ROOT=cache_store
RAG_CACHE_TTL_SECONDS=1800
EMBEDDING_CACHE_ENABLED=true

# Host command execution and temporary runtime files
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_CHARS=12000
SANDBOX_CLEANUP_ON_START=false

# Tool result storage and prompt preview limits
TOOL_RESULT_EXTERNALIZE_CHARS=12000
TOOL_RESULT_PREVIEW_CHARS=2000

# Agent access boundary. Default is read_only.
# read_only: local reads, searches, listings, and document parsing are allowed;
# writes and host command execution are disabled.
# full_access: the current OS account's local filesystem is available; file
# changes and host command execution still require current-task authorization.
AGENT_ACCESS_MODE=read_only
AGENT_DEBUG=false
AGENT_ALLOW_GIT_COMMIT=false

# File Output Policy
# Default directory used only when the user did not specify a path.
# This does not grant write permission; AGENT_ACCESS_MODE is still the access boundary.
AGENT_DEFAULT_OUTPUT_DIR=exports

# Optional persistent user-data root. AGENT_USER_DATA_ROOT is a compatibility alias.
HORIZON_USER_DATA_ROOT=
AGENT_USER_DATA_ROOT=

# Context budget controls
CONTEXT_BUDGET_ENABLED=true
CONTEXT_COMPACT_AUTO=true
CONTEXT_PRUNE_TOOL_OUTPUTS=true

# Browser Tools / Playwright v1
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
BROWSER_MAX_STEPS=8
BROWSER_MAX_TEXT_CHARS=12000
BROWSER_SCREENSHOT_ENABLED=true
BROWSER_SCREENSHOT_DIR=browser_artifacts
BROWSER_ALLOW_EXTERNAL=true
BROWSER_BLOCK_PRIVATE_IP=true
BROWSER_CHANNEL=
BROWSER_USER_AGENT=
DAILY_BROWSER_LIMIT=50

# MCP Runtime Injection
MCP_ENABLED=false
MCP_CONFIG_PATH=config/mcp_servers.local.json
MCP_CONFIG_DIR=config/mcp.d
MCP_DEFAULT_TIMEOUT_SECONDS=30
MCP_MAX_RESULT_CHARS=12000
MCP_GATEWAY_ENABLED=false

# Optional MCP command overrides for local / Windows environments.
# Windows example: MCP_DOCKER_BIN=C:/Program Files/Docker/Docker/resources/bin/docker.exe
MCP_DOCKER_BIN=
MCP_NPX_BIN=
MCP_NODE_BIN=
MCP_NPM_BIN=
MCP_FILESYSTEM_ROOT=

# Optional Cloud MCP foundation. Remote execution remains disabled by default.
CLOUD_MCP_GATEWAY_ENABLED=false
CLOUD_MCP_GATEWAY_ID=default-cloud-mcp-gateway
CLOUD_MCP_GATEWAY_NAME=Cloud MCP Gateway
CLOUD_MCP_GATEWAY_BASE_PATH=/cloud-mcp
CLOUD_MCP_CATALOG_ENABLED=true
CLOUD_MCP_OAUTH_FOUNDATION_ENABLED=true
CLOUD_MCP_TOKEN_STORE_ENABLED=true
CLOUD_MCP_OAUTH_PROVIDERS_ENABLED=true
CLOUD_MCP_PERMISSION_MODEL_ENABLED=true
CLOUD_MCP_REMOTE_CONNECTION_ENABLED=true
CLOUD_MCP_REMOTE_EXECUTION_ENABLED=false
CLOUD_MCP_REMOTE_CONNECTION_MODE=foundation

# Optional standalone Browser MCP server settings
BROWSER_MCP_ALLOW_WRITE=false
BROWSER_MCP_DEBUG=false

# Optional standalone Database MCP server settings
DATABASE_MCP_DRIVER=sqlite
DATABASE_MCP_SQLITE_PATH=
DATABASE_MCP_MYSQL_HOST=
DATABASE_MCP_MYSQL_PORT=3306
DATABASE_MCP_MYSQL_USER=
DATABASE_MCP_MYSQL_PASSWORD=
DATABASE_MCP_MYSQL_DATABASE=
DATABASE_MCP_MYSQL_CHARSET=utf8mb4
DATABASE_MCP_MYSQL_CONNECT_TIMEOUT=5
DATABASE_MCP_MAX_ROWS=1000
