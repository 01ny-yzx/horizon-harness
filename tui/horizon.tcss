/* Keep the terminal's own background and foreground, including transparency. */
Screen {
    background: ansi_default;
    color: ansi_default;
    text-style: none;
}
#app-title, #home-title, #prompt, #prompt-prefix, .user-message { text-style: bold; }
#selection-picker > Label, #connection-form > Label { text-style: bold; }
.answer MarkdownHeader, #live-output MarkdownHeader { text-style: bold; }
/* Textual's default selection derives its background from $primary.
   With ansi_default that can obscure terminal-default text on either theme. */
Screen .screen--selection {
    background: #4a4a4a;
    color: #ffffff;
}
WelcomeScreen { align: center middle; padding: 1 2; background: ansi_default; }
#welcome-art { width: 100%; height: auto; content-align: center middle; background: ansi_default; }
#topbar-row { height: 2; align: center middle; padding: 0 2; border: none; }
#topbar { height: 100%; width: 100%; align-vertical: middle; }
#app-title { width: 19; height: 100%; content-align: left middle; color: ansi_default; }
#session-tabs { width: 1fr; height: 100%; scrollbar-size: 0 0; margin: 0 1; }
.session-tab { width: auto; min-width: 12; max-width: 26; height: 100%; margin: 0; background: ansi_default; }
#topbar .session-tab Button {
    height: 100%; min-height: 1; border: none; margin: 0;
    content-align: center middle;
    background: transparent; color: ansi_default; padding: 0;
}
#topbar .tab-label { width: auto; min-width: 9; max-width: 23; padding-left: 1; text-style: dim; text-wrap: nowrap; text-overflow: ellipsis; }
#topbar .tab-close { width: 3; min-width: 3; text-style: dim; visibility: hidden; }
#topbar .hovered-tab .tab-close { visibility: visible; }
#topbar .active-tab .tab-label { text-style: bold; }
#topbar .session-tab Button:hover, #topbar .session-tab Button:focus {
    text-style: bold; background-tint: transparent; tint: transparent;
}
#topbar #new { width: 3; min-width: 3; margin-left: 0; }
#topbar #history { width: 12; min-width: 12; padding: 0 1; }
.compact-home #app-title { width: 16; }
#topbar Button {
    width: 7; min-width: 6; height: 1; min-height: 1;
    border: none; background: ansi_default; color: ansi_default;
    margin-left: 1;
}
#topbar > Button { height: 100%; content-align: center middle; }
/* Preserve the existing divider position inside the compact header. */
#topbar-row, #topbar, #app-title, #session-tabs, #topbar .session-tab, #topbar Button {
    outline-bottom: solid ansi_bright_black;
}
#workspace { height: 1fr; padding: 0 3 1 3; align: center top; }
#stage { width: 100%; max-width: 104; height: 1fr; }
#home { height: 1fr; padding-top: 2; }
#home-intro { width: 1fr; height: auto; margin-top: 1; }
#home-title { height: 1; }
#home-title-art { display: none; height: 6; }
.large-home #home-title { display: none; }
.large-home #home-title-art { display: block; }
#welcome { height: auto; margin-top: 1; color: ansi_default; }
#home-logo { width: 29; height: 9; }
#logo { width: 100%; height: auto; content-align: center top; }
#transcript { height: 1fr; scrollbar-size: 1 1; background: ansi_default; }
#transcript-tail-space { height: 1fr; min-height: 0; }
#messages { height: auto; background: ansi_default; }
.user-message { height: auto; margin: 1 0; padding-left: 2; border-left: solid ansi_bright_black; }
.answer { height: auto; margin-bottom: 1; padding: 0; background: ansi_default; }
Markdown { background: ansi_default; }
MarkdownFence { background: ansi_default; border: solid ansi_bright_black; text-style: none; }
.tool { height: auto; padding: 0; margin: 0 0 1 0; border: none; background: ansi_default; }
.tool > CollapsibleTitle { background: ansi_default; color: ansi_default; }
.tool Contents { background: ansi_default; }
.tool Static { background: ansi_default; }
#live-output { height: auto; padding: 0; margin-bottom: 1; background: ansi_default; }
#activity { height: auto; max-height: 3; color: ansi_default; margin: 0 0 1 0; }
.chat #activity { padding-left: 4; }
.answer-meta { height: 1; padding-left: 4; margin-bottom: 1; color: ansi_default; text-style: dim; }
#compose-row { height: auto; width: 100%; align-horizontal: center; }
#command-suggestions {
    display: none; height: auto; max-height: 6;
    border: none; border-left: solid ansi_bright_black; border-right: solid ansi_bright_black;
    padding: 0 1; background: ansi_default; color: ansi_default;
}
#command-suggestions > .option-list--option-highlighted {
    color: ansi_default; background: ansi_default; text-style: reverse;
}
#composer {
    height: auto; border: none; border-top: solid ansi_default; border-bottom: solid ansi_default; padding: 0;
    background: ansi_default; width: 100%;
}
#prompt-line { height: auto; width: 100%; }
#prompt-prefix { width: 2; height: 1; }
#prompt {
    width: 1fr; height: 1; min-height: 1; border: none; padding: 0;
    background: ansi_default; color: ansi_default;
}
#prompt:focus { border: none; }
#prompt .text-area--cursor {
    background: ansi_black;
    color: ansi_white;
    text-style: bold;
}
.home #topbar-row { border: none; }
.home #workspace { padding: 0 2 1 2; }
.home #stage { height: 1fr; width: 100%; max-width: 100%; }
.home #app-title { display: block; }
#composer-hint { height: 2; padding-top: 1; color: ansi_default; text-style: none; }
.compact-home #home { layout: vertical; }
.compact-home #home-logo { dock: top; width: 100%; }
.compact-home #home-intro { width: 100%; margin-top: 0; }
.short-home #home, .compact-home #home { padding-top: 0; }
.short-home #home-logo { height: 3; }
.short-home #welcome { margin-top: 0; }
SelectionPicker, ConnectionForm, SearchConfigForm, HelpScreen, SessionDeleteConfirm { align: center middle; background: ansi_default; }
#session-picker, #help-panel {
    width: 80%; max-width: 80; height: auto; max-height: 85%;
    padding: 1 2; border: round ansi_default; background: ansi_default;
}
#session-picker ListView { height: auto; max-height: 18; margin: 1 0; background: ansi_default; }
#session-picker ListItem { background: ansi_default; padding: 0 1; }
#help-panel Button, #session-picker Button {
    background: ansi_default; color: ansi_default; border: none; height: 1; min-height: 1;
}

/* Conversation layout uses the full terminal width. Home keeps its geometry. */
.chat #topbar-row { padding: 0 2; border: none; }
.chat #topbar { max-width: 100%; }
.chat #workspace { padding: 0 2 1 2; }
.chat #stage { max-width: 100%; }
.chat .user-message {
    border-left: none; padding: 1 2;
    background: ansi_default; color: ansi_default;
}
.chat .answer, .chat #live-output { color: ansi_default; padding-left: 4; }
.chat .answer MarkdownParagraph, .chat .answer MarkdownHeader, .chat .answer MarkdownListItem { color: ansi_default; }
/* One blank terminal row between sections; keep list items together. */
#transcript Markdown > MarkdownParagraph { margin: 0 0 1 0; }
#transcript Markdown MarkdownHeader { margin: 1 0; content-align: left middle; }
#transcript Markdown MarkdownFence, #transcript Markdown MarkdownBlockQuote, #transcript Markdown MarkdownTable {
    margin: 1 0;
}
#transcript Markdown MarkdownList { margin: 0 0 1 0; }
#transcript Markdown MarkdownList MarkdownList, #transcript Markdown MarkdownList MarkdownParagraph { margin: 0; }
#transcript Markdown > MarkdownBlock:first-child { margin-top: 0; }
#transcript Markdown > MarkdownBlock:last-child { margin-bottom: 0; }
/* Orange accents belong to reply Markdown, independent of navigation/status colors. */
#transcript .answer MarkdownHeader, #transcript #live-output MarkdownHeader {
    color: #f2a35c; text-style: bold;
}
#transcript .answer MarkdownBlock > .strong, #transcript #live-output MarkdownBlock > .strong {
    color: #f2a35c; text-style: bold;
}
.terminal-light #transcript .answer MarkdownHeader, .terminal-light #transcript #live-output MarkdownHeader {
    color: #b45309;
}
.terminal-light #transcript .answer MarkdownBlock > .strong, .terminal-light #transcript #live-output MarkdownBlock > .strong {
    color: #b45309;
}
.chat .tool > CollapsibleTitle { color: ansi_default; }
#session-picker ListItem.-highlight { background: ansi_default; color: ansi_default; text-style: bold reverse; }

#selection-picker, #connection-form {
    width: 90%; max-width: 90; height: auto; max-height: 90%;
    padding: 1 2; border: round ansi_default; background: ansi_default;
}
#selection-picker { height: 80%; }
#selection-picker Input, #connection-form Input {
    background: ansi_default; color: ansi_default;
    border: none; border-bottom: solid ansi_bright_black;
    height: 2; margin: 0 0 1 0; padding: 0;
}
#picker-options { height: 1fr; border: none; background: ansi_default; padding: 0; }
#picker-options > .option-list--option-highlighted {
    color: ansi_default; background: ansi_default; text-style: reverse;
}
#picker-empty { height: 1; }
.picker-hint { height: auto; margin-top: 1; color: ansi_default; text-style: dim; }
#connection-form { height: 90%; }
#connection-fields { height: 1fr; margin-top: 1; background: ansi_default; }
#connection-form Label { height: 1; }
#connection-form Input:disabled { opacity: 100%; background: ansi_default; color: ansi_default; }
#connection-error { height: auto; max-height: 3; }
.form-actions { height: 1; margin-top: 1; }
.form-actions Button { background: ansi_default; color: ansi_default; border: none; height: 1; min-height: 1; width: 14; }

#connection-form.simple { height: auto; max-width: 64; }
#connection-form.simple #connection-fields { height: auto; }
#selection-picker { height: auto; max-height: 80%; }
#picker-options { height: 1fr; min-height: 1; margin-top: 1; }

.run-outcome { height: auto; padding-left: 4; margin-bottom: 1; text-style: none; }

#composer-footer { height: 2; width: 100%; }
#composer-hint { width: auto; max-width: 55%; }
#workspace-hint { width: 1fr; height: 2; padding-top: 1; content-align: left top; color: ansi_default; text-style: dim; }
#version-hint { width: auto; max-width: 45%; height: 2; padding-top: 1; padding-left: 2; content-align: right top; color: ansi_default; text-style: dim; }
#pending-queue { height: auto; max-height: 6; width: 100%; overflow-y: auto; }
.queue-row { height: 1; width: 100%; }
.queue-title { width: 1fr; height: 1; }
.queue-row Button { height: 1; min-width: 3; width: auto; margin: 0; padding: 0 1; border: none; background: transparent; color: ansi_default; }
QueueConfirm { align: center middle; background: ansi_default 30%; }
#queue-confirm { width: 64; max-width: 90%; height: auto; max-height: 80%; padding: 1 2; border: round ansi_default; background: ansi_default; }
.queue-confirm-title { text-style: bold; margin-bottom: 1; }
#queue-confirm-text { height: auto; max-height: 8; overflow-y: auto; margin-bottom: 1; }
#queue-confirm Horizontal { height: 1; margin-top: 1; }
#queue-confirm Button { height: 1; width: 1fr; min-width: 0; border: none; padding: 0; background: transparent; color: ansi_default; }

#help-content { height: auto; max-height: 19; scrollbar-size: 1 1; }
ShortcutSettings, KeyCapture { align: center middle; background: ansi_default; }
#shortcut-settings, #key-capture { width: 76; max-width: 92%; height: auto; max-height: 85%; border: round ansi_default; padding: 1 2; background: ansi_default; }
.shortcut-title { text-style: bold; margin-bottom: 1; }
#shortcut-options { height: auto; max-height: 13; border: none; padding: 0; margin-bottom: 1; background: ansi_default; color: ansi_default; }
#key-capture-error { height: auto; margin-top: 1; color: ansi_red; }

#help-panel { height: 25; }
#help-content { height: 1fr; max-height: 100%; }
#shortcut-settings { height: 20; }
#shortcut-options { height: 1fr; max-height: 100%; }

#session-delete-confirm {
    width: 54; max-width: 90%; height: auto; padding: 1 2;
    border: round ansi_default; background: ansi_default;
}
#session-delete-warning { height: auto; color: #f2a35c; content-align: center middle; text-align: center; }
.terminal-light #session-delete-warning { color: #b45309; }
.session-delete-actions { height: 1; margin-top: 1; align: center middle; }
.session-delete-actions Button {
    height: 1; min-height: 1; width: 10; min-width: 0; margin: 0 1;
    border: none; background: ansi_default; color: ansi_default;
}
.session-delete-actions Button:focus, .session-delete-actions Button:hover { text-style: bold reverse; }
